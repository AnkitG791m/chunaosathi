# ─── SERVER ──────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production

# ─── FIREBASE ADMIN SDK ──────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
# Set GOOGLE_APPLICATION_CREDENTIALS to path of your serviceAccountKey.json
# OR use Application Default Credentials (ADC) on GCP/Cloud Run automatically

# ─── GOOGLE CLOUD ────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET=chunao-saathi-storage

# ─── CORS ────────────────────────────────────────────────────────
FRONTEND_URL=https://your-project-id.web.app
